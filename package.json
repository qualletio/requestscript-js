{
  "name": "requestscript",
  "version": "1.0.5",
  "description": "The Requestscript programming language and interpreter, with an optional HTTP server",
  "keywords": [
    "requestscript",
    "interpreter",
    "language",
    "parser",
    "lexer"
  ],
  "homepage": "https://github.com/qualletio/requestscript-js#readme",
  "bugs": {
    "url": "https://github.com/qualletio/requestscript-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qualletio/requestscript-js.git"
  },
  "license": "ISC",
  "author": "Christopher Poulsen <christopher.poulsen@quallet.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "requestscript-server": "dist/bin/requestscript-server.js"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "start": "node dist/bin/requestscript-server.js",
    "dev": "tsx watch src/bin/requestscript-server.ts",
    "build": "rm -rf dist && tsc",
    "prepack": "pnpm build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "typescript-eslint>typescript": "~6.0.3",
      "@typescript-eslint/*>typescript": "~6.0.3"
    }
  }
}
